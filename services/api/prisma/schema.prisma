generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id           String  @id @default(cuid())
  phone        String  @unique
  email        String? @unique
  passwordHash String
  firstName    String
  lastName     String?
  isActive     Boolean @default(true)

  defaultTownId String?
  defaultTown   Town?   @relation("CustomerDefaultTown", fields: [defaultTownId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses      CustomerAddress[]
  orders         Order[]
  passwordResets CustomerPasswordReset[]

  @@index([phone])
  @@index([defaultTownId])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  label         String?
  recipientName String
  phone         String?
  line1         String
  line2         String?
  area          String?
  town          String
  landmark      String?
  notes         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isDefault])
}

model CustomerPasswordReset {
  id         String    @id @default(cuid())
  customerId String
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Town {
  id                 String              @id @default(cuid())
  name               String              @unique
  slug               String              @unique
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  townProducts       TownProduct[]
  warehouse          Warehouse?
  suppliers          Supplier[]
  settings           TownSettings?
  promoCodes         PromoCode[]
  drivers            Driver[]
  defaultCustomers   Customer[]          @relation("CustomerDefaultTown")
  adminUsers         AdminUser[]
  adminNotifications AdminNotification[]
}

model Warehouse {
  id        String   @id @default(cuid())
  townId    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  town      Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  categoryId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  townProducts TownProduct[]
  suppliers    ProductSupplier[]

  @@index([categoryId])
}

model Supplier {
  id        String   @id @default(cuid())
  townId    String
  name      String
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  town     Town              @relation(fields: [townId], references: [id], onDelete: Cascade)
  products ProductSupplier[]

  @@unique([townId, name])
  @@index([townId])
}

model ProductSupplier {
  id         String   @id @default(cuid())
  productId  String
  supplierId String
  priority   Int      @default(1)
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
}

model TownProduct {
  id           String       @id @default(cuid())
  townId       String
  productId    String
  pricingModel PricingModel @default(UNIT)

  // For UNIT
  pricePerUnit Decimal? @db.Decimal(12, 2)
  costPerUnit  Decimal? @db.Decimal(12, 2)

  // For WEIGHT (per kg)
  pricePerKg Decimal? @db.Decimal(12, 2)
  costPerKg  Decimal? @db.Decimal(12, 2)

  // Stock snapshot fields (still optional / ledger source of truth)
  stockQty         Int?
  stockWeightGrams Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW: variants (for Small/Medium/Large etc.)
  variants TownProductVariant[]

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  images         TownProductImage[]
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  town           Town               @relation(fields: [townId], references: [id], onDelete: Cascade)

  @@unique([townId, productId])
  @@index([townId])
  @@index([productId])
}

model TownProductVariant {
  id            String   @id @default(cuid())
  townProductId String
  label         String // e.g., "Small", "Medium", "Large", "Half", "1kg bag"
  unitPrice     Decimal  @db.Decimal(12, 2)
  unitCost      Decimal? @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Optional: if you ever want "size" to imply an actual weight for reporting
  packWeightGrams Int?

  townProduct TownProduct @relation(fields: [townProductId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@unique([townProductId, label])
  @@index([townProductId])
  @@index([isActive])
}

model TownProductImage {
  id            String   @id @default(cuid())
  townProductId String
  url           String
  alt           String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  townProduct TownProduct @relation(fields: [townProductId], references: [id], onDelete: Cascade)

  @@unique([townProductId, url])
  @@unique([townProductId, sortOrder])
  @@index([townProductId])
}

model Order {
  id                    String        @id @default(cuid())
  townId                String
  status                OrderStatus   @default(DRAFT)
  customerEmail         String?
  customerPhone         String?
  subtotal              Decimal       @default(0.00) @db.Decimal(12, 2)
  total                 Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deliveryFee           Decimal       @default(0) @db.Decimal(12, 2)
  itemsSubtotal         Decimal       @default(0) @db.Decimal(12, 2)
  payNowTotal           Decimal       @default(0) @db.Decimal(12, 2)
  payOnDeliveryTotal    Decimal       @default(0) @db.Decimal(12, 2)
  serviceFee            Decimal       @default(0) @db.Decimal(12, 2)
  deliveryCodeExpiresAt DateTime?
  deliveryCodeHash      String?
  deliveryRecipientName String?
  deliveryPhone         String?
  deliveryLine1         String?
  deliveryLine2         String?
  deliveryArea          String?
  deliveryTown          String?
  deliveryLandmark      String?
  deliveryNotes         String?
  driverName            String?
  driverPhone           String?
  driverAssignedAt      DateTime?
  deliveredAt           DateTime?
  driverId              String?
  driver                Driver?       @relation(fields: [driverId], references: [id])
  goodsPaymentMethod    PaymentMethod @default(COD)
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  town        Town         @relation(fields: [townId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  payments    Payment[]
  sale        Sale?
  promoUsages PromoUsage[]

  @@index([customerId])
  @@index([townId])
  @@index([status])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  townProductId String

  // NEW: only set when pricingModel = VARIANT
  townProductVariantId String?

  quantity    Int?
  weightGrams Int?

  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  townProduct TownProduct         @relation(fields: [townProductId], references: [id], onDelete: Cascade)
  variant     TownProductVariant? @relation(fields: [townProductVariantId], references: [id], onDelete: SetNull)

  refundItems RefundItem[]
  saleItem    SaleItem?

  @@index([orderId])
  @@index([townProductId])
  @@index([townProductVariantId])
}

model StockMovement {
  id String @id @default(cuid())

  townProductId String
  townProduct   TownProduct @relation(fields: [townProductId], references: [id], onDelete: Cascade)

  // One of these should be set (UNIT vs WEIGHT)
  deltaQty         Int?
  deltaWeightGrams Int?

  reason StockMovementReason

  // optional links for audit context
  orderId  String?
  refundId String?

  note      String?
  createdAt DateTime @default(now())

  @@index([townProductId, createdAt])
  @@index([reason, createdAt])
  @@index([orderId])
  @@index([refundId])
}

model Sale {
  id        String   @id @default(cuid())
  orderId   String   @unique
  townId    String
  createdAt DateTime @default(now())

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items SaleItem[]

  @@index([townId, createdAt])
}

model SaleItem {
  id            String @id @default(cuid())
  saleId        String
  orderItemId   String @unique
  townProductId String

  quantity    Int?
  weightGrams Int?

  unitPrice Decimal @db.Decimal(12, 2)
  revenue   Decimal @db.Decimal(12, 2)

  unitCost Decimal @db.Decimal(12, 2) // frozen at delivery time (per unit or per kg)
  cogs     Decimal @db.Decimal(12, 2)
  profit   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  townProduct TownProduct @relation(fields: [townProductId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([townProductId, createdAt])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("GHS")
  status           RefundStatus @default(REQUESTED)
  reason           String?
  restock          Boolean      @default(false)
  provider         String?
  providerRefundId String?
  providerResponse Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  Payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  items   RefundItem[]

  @@index([paymentId])
  @@index([status])
}

model RefundItem {
  id          String   @id @default(cuid())
  refundId    String
  orderItemId String
  quantity    Int?
  weightGrams Int?
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([orderItemId])
}

model TownSettings {
  id           String  @id @default(cuid())
  townId       String  @unique
  deliveryFee  Decimal @default(0)
  serviceFee   Decimal @default(0)
  minimumOrder Decimal @default(0)
  currency     String  @default("GBP")

  town Town @relation(fields: [townId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id                  String         @id @default(cuid())
  orderId             String
  purpose             PaymentPurpose
  method              PaymentMethod
  status              PaymentStatus  @default(PENDING)
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("GHS")
  provider            String?
  clientReference     String?        @unique
  hubtelTransactionId String?
  hubtelResponse      Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Refund Refund[]

  @@unique([orderId, purpose])
  @@index([orderId])
  @@index([status])
  @@index([method])
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      PromoType
  value     Decimal?  @db.Decimal(12, 2)
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  townId String?
  town   Town?   @relation(fields: [townId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages PromoUsage[]

  @@index([code])
  @@index([townId])
  @@index([isActive])
}

model PromoUsage {
  id          String   @id @default(cuid())
  promoCodeId String
  orderId     String?
  phone       String?
  createdAt   DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([promoCodeId])
  @@index([orderId])
  @@index([phone])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         AdminRole @default(WAREHOUSE_ADMIN)

  townId String?
  town   Town?   @relation(fields: [townId], references: [id], onDelete: SetNull)

  isActive               Boolean   @default(true)
  resetPasswordCodeHash  String?
  resetPasswordExpiresAt DateTime?
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([townId])
}

model Driver {
  id             String             @id @default(cuid())
  townId         String
  name           String
  phone          String
  isActive       Boolean            @default(true)
  availability   DriverAvailability @default(AVAILABLE)
  priority       Int                @default(100)
  lastAssignedAt DateTime?

  town   Town    @relation(fields: [townId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([townId])
  @@index([townId, isActive, availability])
  @@index([townId, priority])
}

model AdminNotification {
  id String @id @default(cuid())

  townId String?
  town   Town?   @relation(fields: [townId], references: [id], onDelete: SetNull)

  type    String
  title   String
  message String

  orderId  String?
  driverId String?

  role AdminRole?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([townId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

enum PromoType {
  DELIVERY_FREE
  SERVICE_FREE
  PERCENTAGE
  FIXED
}

enum AdminRole {
  GLOBAL_SUPER_ADMIN
  TOWN_SUPER_ADMIN
  WAREHOUSE_ADMIN
  DRIVER
}

enum PricingModel {
  UNIT
  WEIGHT
  VARIANT
}

enum PaymentPurpose {
  UPFRONT_FEES
  COD_GOODS
}

enum PaymentMethod {
  MOMO
  COD
}

enum DriverAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  NEEDS_EDIT
  CONFIRMED
  FULFILLED
  SETTLED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  SUCCESS
  FAILED
}

enum StockMovementReason {
  FULFILMENT
  REFUND
  MANUAL_ADJUSTMENT
}
