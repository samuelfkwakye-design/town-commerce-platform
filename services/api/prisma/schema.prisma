generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Town {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  townProducts TownProduct[]
  warehouse    Warehouse?
}

model Warehouse {
  id        String   @id @default(cuid())
  townId    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  town      Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
}

model Product {
  id           String        @id @default(cuid())
  name         String
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  townProducts TownProduct[]
}

model TownProduct {
  id               String       @id @default(cuid())
  townId           String
  productId        String
  pricingModel     PricingModel @default(UNIT)
  pricePerUnit     Decimal?     @db.Decimal(12, 2)
  pricePerKg       Decimal?     @db.Decimal(12, 2)
  costPerUnit     Decimal?     @db.Decimal(12, 2)
  costPerKg       Decimal?     @db.Decimal(12, 2)
  stockQty         Int?
  stockWeightGrams Int?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  town    Town    @relation(fields: [townId], references: [id], onDelete: Cascade)

  @@unique([townId, productId])
  @@index([townId])
  @@index([productId])
}

model Order {
  id                    String        @id @default(cuid())
  townId                String
  status                OrderStatus   @default(DRAFT)
  customerEmail         String?
  customerPhone         String?
  subtotal              Decimal       @default(0.00) @db.Decimal(12, 2)
  total                 Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deliveryFee           Decimal       @default(0) @db.Decimal(12, 2)
  itemsSubtotal         Decimal       @default(0) @db.Decimal(12, 2)
  payNowTotal           Decimal       @default(0) @db.Decimal(12, 2)
  payOnDeliveryTotal    Decimal       @default(0) @db.Decimal(12, 2)
  serviceFee            Decimal       @default(0) @db.Decimal(12, 2)
  deliveryCodeExpiresAt DateTime?
  deliveryCodeHash      String?
  goodsPaymentMethod    PaymentMethod @default(COD)
  town                  Town          @relation(fields: [townId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  payments              Payment[]

  @@index([townId])
  @@index([status])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  townProductId String
  quantity      Int?
  weightGrams   Int?
  unitPrice     Decimal  @db.Decimal(12, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  townProduct TownProduct  @relation(fields: [townProductId], references: [id], onDelete: Cascade)
  refundItems RefundItem[]

  @@index([orderId])
  @@index([townProductId])
}

model StockMovement {
  id String @id @default(cuid())

  townProductId String
  townProduct   TownProduct @relation(fields: [townProductId], references: [id], onDelete: Cascade)

  // One of these should be set (UNIT vs WEIGHT)
  deltaQty         Int?
  deltaWeightGrams Int?

  reason StockMovementReason

  // optional links for audit context
  orderId  String?
  refundId String?

  note      String?
  createdAt DateTime @default(now())

  @@index([townProductId, createdAt])
  @@index([reason, createdAt])
  @@index([orderId])
  @@index([refundId])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("GHS")
  status           RefundStatus @default(REQUESTED)
  reason           String?
  restock          Boolean      @default(false)
  provider         String?
  providerRefundId String?
  providerResponse Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  Payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  items            RefundItem[]

  @@index([paymentId])
  @@index([status])
}

model RefundItem {
  id          String    @id @default(cuid())
  refundId    String
  orderItemId String
  quantity    Int?
  weightGrams Int?
  amount      Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([orderItemId])
}

model Payment {
  id                  String         @id @default(cuid())
  orderId             String
  purpose             PaymentPurpose
  method              PaymentMethod
  status              PaymentStatus  @default(PENDING)
  amount              Decimal        @db.Decimal(12, 2)
  currency            String         @default("GHS")
  provider            String?
  clientReference     String?        @unique
  hubtelTransactionId String?
  hubtelResponse      Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Refund              Refund[]

  @@unique([orderId, purpose])
  @@index([orderId])
  @@index([status])
  @@index([method])
}

enum PricingModel {
  UNIT
  WEIGHT
}

enum PaymentPurpose {
  UPFRONT_FEES
  COD_GOODS
}

enum PaymentMethod {
  MOMO
  COD
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PAID
  FULFILLED
  SETTLED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  SUCCESS
  FAILED
}

enum StockMovementReason {
  FULFILMENT
  REFUND
  MANUAL_ADJUSTMENT
}
